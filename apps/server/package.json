{
	"name": "note-app-server",
	"version": "1.0.0",
	"description": "Backend for note app",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"dev": "nodemon --exec tsx src/index.ts",
		"build": "tsc",
		"start": "node ./dist/src/index.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:reset": "rm -f ./data/database.db && npm run db:migrate",
		"lint": "eslint src/**/*.ts",
		"lint:fix": "eslint src/**/*.ts --fix"
	},
	"author": "",
	"license": "ISC",
	"dependencies": {
		"bcrypt": "^6.0.0",
		"better-sqlite3": "^12.4.1",
		"drizzle-orm": "^0.44.6",
		"express": "^5.1.0",
		"jsonwebtoken": "^9.0.2"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/express": "^5.0.3",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^24.7.1",
		"@typescript-eslint/eslint-plugin": "^8.46.0",
		"@typescript-eslint/parser": "^8.46.0",
		"drizzle-kit": "^0.31.5",
		"eslint": "^9.37.0",
		"nodemon": "^3.1.10",
		"ts-node": "^10.9.2",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3"
	}
}

{
	"compilerOptions": {
		// General
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"target": "ESNext",

		// Modules
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,

		// Type Checking & Safety
		"strict": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["vite/client"]
	}
}
